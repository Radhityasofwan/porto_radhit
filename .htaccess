# === PERFORMANCE & SECURITY ===

# GZIP Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    # CSS & JS - 1 year (versioned by filename if needed)
    ExpiresByType text/css                  "access plus 1 year"
    ExpiresByType application/javascript    "access plus 1 year"
    # Images - 1 year
    ExpiresByType image/jpeg                "access plus 1 year"
    ExpiresByType image/png                 "access plus 1 year"
    ExpiresByType image/webp                "access plus 1 year"
    ExpiresByType image/gif                 "access plus 1 year"
    ExpiresByType image/svg+xml             "access plus 1 year"
    ExpiresByType image/x-icon             "access plus 1 year"
    # Fonts - 1 year
    ExpiresByType font/woff                 "access plus 1 year"
    ExpiresByType font/woff2                "access plus 1 year"
    # PDF - 1 month
    ExpiresByType application/pdf           "access plus 1 month"
    # HTML/PHP - no cache (dynamic content from DB)
    ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

# Cache-Control Headers
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
    <FilesMatch "\.(woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # PHP pages - never cache (content dari database)
    <FilesMatch "\.php$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header unset ETag
        Header unset Last-Modified
    </FilesMatch>
    # Security headers
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Keep-Alive
<IfModule mod_headers.c>
    Header set Connection keep-alive
</IfModule>

# === URL REWRITING (router.php) ===
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block access to backup files and sensitive files
    RewriteRule \.(bak|sql|py|ps1|log|zip)$ - [F,L]

    # Dev-only: skrip maintenance & migrasi tidak boleh diakses dari web
    RewriteRule ^(maintenance|migrations)(/|$) - [F,L]

    # Serve static files directly
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Sitemap
    RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]

    # Portfolio / Project detail
    RewriteRule ^portfolio/([^/]+)/?$ project-details.php?slug=$1 [L,QSA]

    # Blog / Article detail
    RewriteRule ^blog/([^/]+)/?$ article.php?slug=$1 [L,QSA]

    # Everything else -> index.php
    RewriteRule ^ index.php [L,QSA]
</IfModule>

# === SECURITY: Block sensitive files ===
<FilesMatch "\.(bak|sql|ps1|py|log)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block directory listing
Options -Indexes
